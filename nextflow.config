manifest {
    name            = 'pggb-nf'
    description     = 'Genome-agnostic Nextflow wrapper around upstream PGGB'
    author          = 'Ayo Fakoya'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.2.0'
}

params {
    input             = null
    outdir            = 'results'
    pggb_package      = 'bioconda::pggb=0.7.4'
    map_pct_id        = null
    segment_length    = 20000
    block_length      = 100000
    min_match_length  = 23
    n_mappings        = 1
    vcf_spec          = null
    pggb_args         = ''
    community         = false
    help              = false
}

conda.channels = 'conda-forge,bioconda,defaults'

wave {
    enabled  = true
    freeze   = true
    strategy = ['conda']
}

process {
    resourceLimits = [cpus: 32, memory: 256.GB, time: 72.h]
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_low {
        cpus = 2
        memory = 8.GB
        time = 2.h
    }
    withLabel: process_medium {
        cpus = 8
        memory = 32.GB
        time = 12.h
    }
    withLabel: process_high {
        cpus = 16
        memory = 96.GB
        time = 48.h
        maxForks = 1
    }
}

profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        conda.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
        singularity.enabled = false
        conda.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        apptainer.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        wave.enabled = false
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }
    ec2 {
        process.executor = 'local'
        workDir = System.getenv('NXF_WORK') ?: '/tmp/nextflow-work'
        process {
            withLabel: process_high {
                memory = 120.GB
                time = 7.days
                maxForks = 1
            }
        }
    }
    test {
        params.input = 'assets/samplesheet_example.csv'
        process.executor = 'local'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
